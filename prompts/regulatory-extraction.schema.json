{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegulatoryExtractionV1",
  "type": "object",
  "required": [
    "documento",
    "medicamentos_deferidos",
    "medicamentos_indeferidos",
    "suplementos_deferidos",
    "suplementos_indeferidos",
    "estudos_clinicos_deferidos",
    "estudos_clinicos_indeferidos",
    "outros_atos",
    "exigencias",
    "pendencias",
    "categorias_nao_localizadas",
    "evidencias_insuficientes",
    "contradicoes",
    "avisos",
    "controle_confianca",
    "revisao_humana"
  ],
  "properties": {
    "documento": {"type": "object"},
    "medicamentos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "medicamentos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "suplementos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "suplementos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "estudos_clinicos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "estudos_clinicos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "outros_atos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "exigencias": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "pendencias": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "categorias_nao_localizadas": {"type": "array"},
    "evidencias_insuficientes": {"type": "array", "items": {"type": "string"}},
    "contradicoes": {"type": "array", "items": {"type": "string"}},
    "avisos": {"type": "array"},
    "cancelados": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "controle_confianca": {
      "type": "object",
      "required": ["status", "motivos"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["aceitavel", "baixa_confianca", "inconclusivo"]
        },
        "motivos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "revisao_humana": {
      "type": "object",
      "required": ["necessaria", "motivos"],
      "properties": {
        "necessaria": {"type": "boolean"},
        "motivos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "achado": {
      "type": "object",
      "required": ["paginas_origem", "evidencia"],
      "properties": {
        "paginas_origem": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "evidencia": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["deferido", "indeferido", "cancelado", "outro"]},
        "tipo_produto_relacionado": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
