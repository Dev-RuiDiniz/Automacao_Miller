{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegulatoryExtractionV2",
  "type": "object",
  "required": [
    "documento",
    "medicamentos_deferidos",
    "medicamentos_indeferidos",
    "suplementos_deferidos",
    "suplementos_indeferidos",
    "estudos_clinicos_deferidos",
    "estudos_clinicos_indeferidos",
    "outros_atos",
    "exigencias",
    "pendencias",
    "categorias_nao_localizadas",
    "evidencias_insuficientes",
    "contradicoes",
    "avisos",
    "controle_confianca",
    "revisao_humana",
    "parecer_tecnico"
  ],
  "properties": {
    "documento": {"type": "object"},
    "medicamentos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "medicamentos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "suplementos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "suplementos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "estudos_clinicos_deferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "estudos_clinicos_indeferidos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "outros_atos": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "exigencias": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "pendencias": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "categorias_nao_localizadas": {"type": "array"},
    "evidencias_insuficientes": {"type": "array", "items": {"type": "string"}},
    "contradicoes": {"type": "array", "items": {"type": "string"}},
    "avisos": {"type": "array"},
    "cancelados": {"type": "array", "items": {"$ref": "#/$defs/achado"}},
    "controle_confianca": {
      "type": "object",
      "required": ["status", "motivos"],
      "properties": {
        "status": {"type": "string", "enum": ["aceitavel", "baixa_confianca", "inconclusivo"]},
        "motivos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "revisao_humana": {
      "type": "object",
      "required": ["necessaria", "motivos"],
      "properties": {
        "necessaria": {"type": "boolean"},
        "motivos": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "parecer_tecnico": {"$ref": "#/$defs/parecer_tecnico"}
  },
  "additionalProperties": false,
  "$defs": {
    "achado": {
      "type": "object",
      "required": ["paginas_origem", "evidencia"],
      "properties": {
        "paginas_origem": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "evidencia": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["deferido", "indeferido", "cancelado", "outro"]},
        "tipo_produto_relacionado": {"type": "string"}
      },
      "additionalProperties": true
    },
    "fundamento": {
      "type": "object",
      "required": ["id", "fato_documentado", "interpretacao_tecnica", "paginas_origem", "evidencia"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fato_documentado": {"type": "string", "minLength": 1},
        "interpretacao_tecnica": {"type": "string", "minLength": 1},
        "paginas_origem": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "evidencia": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "apontamento_tecnico": {
      "type": "object",
      "required": ["id", "classificacao", "titulo", "constatacao", "impacto", "prioridade", "acao_recomendada", "paginas_origem", "evidencia"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "classificacao": {"type": "string", "enum": ["conformidade", "nao_conformidade_potencial", "exigencia", "pendencia", "risco", "contradicao", "lacuna_documental"]},
        "titulo": {"type": "string", "minLength": 1},
        "constatacao": {"type": "string", "minLength": 1},
        "impacto": {"type": "string", "minLength": 1},
        "prioridade": {"type": "string", "enum": ["critica", "alta", "media", "baixa", "informativa"]},
        "acao_recomendada": {"type": "string", "minLength": 1},
        "responsavel_sugerido": {"type": "string"},
        "prazo_referencia": {"type": "string"},
        "paginas_origem": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "evidencia": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "recomendacao": {
      "type": "object",
      "required": ["id", "acao", "justificativa", "prioridade", "base_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "acao": {"type": "string", "minLength": 1},
        "justificativa": {"type": "string", "minLength": 1},
        "prioridade": {"type": "string", "enum": ["critica", "alta", "media", "baixa", "informativa"]},
        "responsavel_sugerido": {"type": "string"},
        "dependencia": {"type": "string"},
        "base_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "parecer_tecnico": {
      "type": "object",
      "required": ["escopo", "conclusao_preliminar", "classificacao_geral", "nivel_risco", "base_ids", "fundamentos", "apontamentos_tecnicos", "recomendacoes", "limites"],
      "properties": {
        "escopo": {"type": "string", "minLength": 1},
        "conclusao_preliminar": {"type": "string", "minLength": 1},
        "classificacao_geral": {"type": "string", "enum": ["conforme_indicado", "nao_conforme_indicada", "misto", "inconclusivo", "sem_ocorrencia"]},
        "nivel_risco": {"type": "string", "enum": ["baixo", "medio", "alto", "critico", "nao_classificado"]},
        "base_ids": {"type": "array", "items": {"type": "string"}},
        "fundamentos": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/fundamento"}},
        "apontamentos_tecnicos": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/apontamento_tecnico"}},
        "recomendacoes": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/recomendacao"}},
        "limites": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
