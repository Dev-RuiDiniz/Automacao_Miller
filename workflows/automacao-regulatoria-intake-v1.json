      "position": [500, 0]
    },
    {
      "parameters": {"method": "POST", "url": "={{ $env.UPLOAD_GATEWAY_BASE_URL + '/internal/submissions/' + $('Landing - Receber protocolo').item.json.body.submission_id + '/status' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"status\":\"processando\"}", "options": {"timeout": 10000}},
      "id": "landing-status-processing",
      "name": "Landing - Marcar processamento iniciado",
