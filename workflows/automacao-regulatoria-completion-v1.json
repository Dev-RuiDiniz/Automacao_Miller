{
  "name": "Automacao Regulatoria - Atualizar status da Landing",
  "nodes": [
    {"parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 1}]}}, "id": "completion-schedule", "name": "Verificar processamentos", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [0, 0]},
    {"parameters": {"operation": "executeQuery", "query": "SELECT s.submission_id, s.status AS submission_status, dp.status, dp.report_file_id, dp.error_category, dp.error_message FROM automacao_miller.submissions s JOIN automacao_miller.document_processing dp ON dp.source_sha256 = s.sha256 WHERE (dp.status IN ('concluido', 'aguardando_revisao', 'erro') OR s.status = 'erro') AND s.status NOT IN ('concluido', 'aguardando_revisao', 'erro');"}, "id": "completion-query", "name": "Consultar estados regulatórios", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [240, 0]},
    {"parameters": {"jsCode": "return items.map(({ json }) => { const status = json.status === 'concluido' ? 'concluido' : json.status === 'aguardando_revisao' ? 'aguardando_revisao' : 'erro'; const message = json.error_message || (status === 'aguardando_revisao' ? 'O resultado exige revisão humana.' : null); const report_path = json.report_file_id && status !== 'erro' ? '/data/submissions/' + json.submission_id + '-report.pdf' : undefined; return { json: { ...json, landing_status: status, landing_message: message, report_path } }; });"}, "id": "completion-normalize", "name": "Preparar atualização da Landing", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [500, 0]},
    {"parameters": {"conditions": {"string": [{"value1": "={{ $json.report_file_id || '' }}", "operation": "isNotEmpty"}]}}, "id": "completion-has-report", "name": "Há relatório para copiar?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [700, 0]},
    {"parameters": {"resource": "file", "operation": "download", "fileId": "={{ $json.report_file_id }}", "binaryPropertyName": "data"}, "id": "completion-download-report", "name": "Google Drive - Baixar relatório", "type": "n8n-nodes-base.googleDrive", "typeVersion": 3, "position": [940, 0]},
    {"parameters": {"operation": "write", "fileName": "={{ '/data/submissions/' + $json.submission_id + '-report.pdf' }}", "dataPropertyName": "data"}, "id": "completion-write-report", "name": "Persistir relatório para download", "type": "n8n-nodes-base.writeBinaryFile", "typeVersion": 1, "position": [1200, 0]},
    {"parameters": {"method": "POST", "url": "={{ $env.UPLOAD_GATEWAY_BASE_URL + '/internal/submissions/' + $json.submission_id + '/status' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "X-Internal-Token", "value": "={{ $env.INTERNAL_API_TOKEN }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ status: $json.landing_status, message: $json.landing_message, report_path: $json.report_path }) }}", "options": {"timeout": 10000}}, "id": "completion-update-status", "name": "Landing - Atualizar protocolo", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1460, 0]}
  ],
  "connections": {
    "Verificar processamentos": {"main": [[{"node": "Consultar estados regulatórios", "type": "main", "index": 0}]]},
    "Consultar estados regulatórios": {"main": [[{"node": "Preparar atualização da Landing", "type": "main", "index": 0}]]},
    "Preparar atualização da Landing": {"main": [[{"node": "Há relatório para copiar?", "type": "main", "index": 0}]]},
    "Há relatório para copiar?": {"main": [[{"node": "Google Drive - Baixar relatório", "type": "main", "index": 0}], [{"node": "Landing - Atualizar protocolo", "type": "main", "index": 0}]]},
    "Google Drive - Baixar relatório": {"main": [[{"node": "Persistir relatório para download", "type": "main", "index": 0}]]},
    "Persistir relatório para download": {"main": [[{"node": "Landing - Atualizar protocolo", "type": "main", "index": 0}]]}
  },
