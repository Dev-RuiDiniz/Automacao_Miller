# Este arquivo documenta configurações não secretas.
# Nunca coloque tokens, senhas, chaves ou credenciais reais aqui.
# As credenciais Google devem ser configuradas nas credenciais internas do n8n.

# URLs dos serviços
N8N_BASE_URL=<url-base-do-n8n>
OLLAMA_BASE_URL=<url-base-do-ollama>
PDF_CONVERTER_BASE_URL=<url-interna-do-conversor-pdf>
REPORT_RENDERER_BASE_URL=<url-interna-do-renderizador-de-relatorios>
PDF_CONVERTER_TIMEOUT_SECONDS=<timeout-do-conversor>
PDF_CONVERTER_VERSION=<versao-do-conversor>
PDF_MARKDOWN_FILENAME_PATTERN=<padrao-de-nome-do-markdown>

# Banco e n8n - gerar valores reais somente no servidor autorizado
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=<senha-aleatoria-do-postgres>
N8N_ENCRYPTION_KEY=<chave-aleatoria-longa-do-n8n>
N8N_HOST_PORT=25678
N8N_EDITOR_BASE_URL=http://localhost:25678
WEBHOOK_URL=http://localhost:25678/
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Modelo local — definir após validação dos recursos da VPS
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Integração legada de importação pelo Google Drive — opcional após a migração;
# preencher somente no ambiente autorizado enquanto estiver em uso.
GOOGLE_DRIVE_INPUT_FOLDER_ID=<id-pasta-entrada>
GOOGLE_DRIVE_PROCESSING_FOLDER_ID=<id-pasta-processamento>
GOOGLE_DRIVE_COMPLETED_FOLDER_ID=<id-pasta-concluidos>
GOOGLE_DRIVE_REVIEW_FOLDER_ID=<id-pasta-revisao>
GOOGLE_DRIVE_ERROR_FOLDER_ID=<id-pasta-erros>
GOOGLE_DRIVE_MARKDOWN_FOLDER_ID=<id-pasta-markdown>
GOOGLE_DRIVE_REPORT_FOLDER_ID=<id-pasta-relatorios>

# Parâmetros operacionais — definir durante a configuração do workflow
WORKFLOW_TIMEOUT_SECONDS=<timeout-em-segundos>
WORKFLOW_RETRY_ATTEMPTS=<numero-de-tentativas>
REPORT_RECIPIENTS=<destinatarios-a-definir>

# Landing privada e gateway de upload — gerar os tokens somente no ambiente autorizado
LANDING_ACCESS_TOKEN=<token-privado-da-landing>
INTERNAL_API_TOKEN=<token-interno-entre-gateway-e-n8n>
LANDING_USERNAME=<usuario-da-landing>
LANDING_PASSWORD_HASH=<hash-pbkdf2-da-senha>
AUTH_SESSION_SECRET=<segredo-aleatorio-da-sessao>
AUTH_SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
N8N_SUBMISSION_WEBHOOK_URL=<url-interna-do-webhook-de-entrada>
UPLOAD_GATEWAY_BASE_URL=http://upload-gateway:8085
# Volume interno atual do gateway e da landing
UPLOAD_STORAGE_DIR=/data/submissions
# Diretório planejado para a organização interna de artefatos após a migração.
# ARTIFACT_STORAGE_DIR=/data/artifacts
GENERIC_TIMEZONE=America/Sao_Paulo
EXECUTIONS_DATA_MAX_AGE=168
